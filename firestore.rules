rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Slang terms: any signed-in user can read the feed and create new
    // terms. Only the person who originally submitted a term can update
    // or delete it — checked against the submittedBy field already
    // stored on the document.
    match /slang_terms/{termId} {
      allow read, create: if request.auth != null;
      allow update, delete: if request.auth != null
        && (resource.data.submittedBy == request.auth.uid
            || get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isAdmin == true);
    }

    // User profile docs (xp, savedTerms, learnedTerms, etc.): a user can
    // only read or write their own document, never someone else's.
    match /users/{userId} {
      allow read, write: if request.auth != null
        && request.auth.uid == userId;
    }

    // Flags: any signed-in user can read the flag list and report a term.
    // Only admins can dismiss a flag or mark it actioned/deleted.
    match /flags/{flagId} {
      allow read, create: if request.auth != null;
      allow update, delete: if request.auth != null
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isAdmin == true;
    }
  }
}